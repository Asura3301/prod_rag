# Application
RAG_APP_NAME=prod-rag
RAG_ENVIRONMENT=development
RAG_DEBUG=false
RAG_API_TOKEN=change-me
RAG_ADMIN_TOKEN=change-me

# Provider-neutral LLM configuration
RAG_LLM__PROVIDER=openai
RAG_LLM__MODEL=gpt-4o-mini
RAG_LLM__API_KEY=
# RAG_LLM__BASE_URL=https://api.example.com/v1
RAG_LLM__TIMEOUT_SECONDS=30
RAG_LLM__MAX_RETRIES=3
RAG_LLM__TEMPERATURE=0
RAG_LLM__MAX_TOKENS=2048

# Provider-neutral embedding configuration
RAG_EMBEDDINGS__PROVIDER=openai
RAG_EMBEDDINGS__MODEL=text-embedding-3-small
RAG_EMBEDDINGS__API_KEY=
# RAG_EMBEDDINGS__BASE_URL=https://api.example.com/v1
# RAG_EMBEDDINGS__DIMENSIONS=1536
RAG_EMBEDDINGS__BATCH_SIZE=64

# Vector store
RAG_VECTOR_STORE__PROVIDER=memory
RAG_VECTOR_STORE__INDEX_NAME=documents
RAG_VECTOR_STORE__NAMESPACE=default
# RAG_VECTOR_STORE__URL=http://localhost:6333
# RAG_VECTOR_STORE__API_KEY=
POSTGRES_DSN=postgresql://rag:rag-local-only@localhost:5432/rag
REDIS_URL=redis://localhost:6379/0

# RAG behavior
RAG_CHUNKING__CHUNK_SIZE=800
RAG_CHUNKING__CHUNK_OVERLAP=120
RAG_RETRIEVAL__TOP_K=5
# RAG_RETRIEVAL__SCORE_THRESHOLD=0.7

# Logging
RAG_LOGGING__LEVEL=INFO
RAG_LOGGING__JSON=true

# Optional OpenTelemetry export
# OTEL_SERVICE_NAME=prod-rag-api
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
